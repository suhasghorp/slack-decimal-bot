# Slack Bot Credentials
SLACK_BOT_TOKEN=xoxb-your-bot-token-here
SLACK_APP_TOKEN=xapp-your-app-level-token-here

# SQL Server Connection String
# Example: Driver={ODBC Driver 17 for SQL Server};Server=SERVER_NAME;Database=DB_NAME;Trusted_Connection=yes;
SQL_CONNECTION_STRING=Driver={ODBC Driver 17 for SQL Server};Server=YOUR_SERVER;Database=YOUR_DB;Trusted_Connection=yes;

# Slack Channel Configuration
SLACK_CHANNEL_ID=C0XXXXXX  # Channel where monthly submission buttons are posted

# Target Users (comma-separated list of Slack user IDs)
TARGET_USER_IDS=U123456,U234567,U345678

# Monthly Schedule Configuration
TRIGGER_DAY_OF_MONTH=1
TRIGGER_HOUR=9
TRIGGER_MINUTE=0

# Submission Deadline (days from trigger)
SUBMISSION_DEADLINE_DAYS=10

# Decimal Validation
MIN_DECIMAL=0.00
MAX_DECIMAL=100.00

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/bot.log

# Health Endpoint
HEALTH_PORT=5000
HEALTH_HOST=0.0.0.0

# Slack Proxy Configuration (Optional - for corporate environments)
# Only set these if outbound Slack access requires a proxy
# SLACK_PROXY_URL=http://proxy.company.com:8080
# SLACK_PROXY_HEADERS={"Proxy-Authorization": "Bearer token", "Custom-Header": "value"}
